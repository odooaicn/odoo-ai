registerTemplate("web.OfflineSystray", `/web/static/src/webclient/offline_systray/offline_systray.xml`, `<t t-name="web.OfflineSystray" xml:space="preserve">
        <Dropdown t-if="this.offlinePlugin.isOffline() or this.offlinePlugin.hasScheduledCalls" navigationOptions="{ 'shouldFocusChildInput': false }" disabled="!this.offlinePlugin.hasScheduledCalls">
            <div t-if="this.uiService.isSmall" t-on-click="() =&gt; this.offlinePlugin.checkConnection()" class="o_nav_entry o_offline_systray">
                    <i t-attf-class="{{ this.labelIcon }} {{ this.labelColor }}" role="img" t-att-aria-label="this.labelText" t-att-data-tooltip="this.labelText"/>
            </div>
            <button t-else="" t-attf-class="o_nav_entry px-2 o_tag {{ this.labelColor }} o_offline_systray" data-available-offline="" t-on-click="() =&gt; this.offlinePlugin.checkConnection()" data-tooltip="Click to check connection and Sync">
                <i t-attf-class="{{ this.labelIcon }} me-1"/><t t-out="this.labelText"/><i t-if="this.offlinePlugin.hasScheduledCalls" class="fa fa-caret-down ms-2"/>
            </button>
            <t t-set-slot="content">
                <div class="o_offline_systray_content px-2">
                    <t t-foreach="this.groupEntries()" t-as="entry" t-key="entry[0]">
                        <div class="o_horizontal_separator text-uppercase fw-bolder small mb-1">
                            <span t-out="entry[0]"/>
                        </div>
                        <t t-foreach="entry[1]" t-as="element" t-key="element.id">
                            <DropdownItem onSelected="() =&gt; element.clickable and this.openView(element.id)" closingMode="element.clickable ? 'all' : 'none'" class="{                                     'pe-1': true,                                     'px-0': true,                                     'd-flex': true,                                     'o_cursor_auto': !element.clickable,                                     'o_disabled_while_sync': this.offlinePlugin.syncingORM(),                                     'mb-2': element_last,                                  }">
                                <div t-attf-class="text-truncate {{element.error ? 'text-danger': ''}} {{ element.clickable ? '' : 'text-muted'}}" t-att-data-tooltip="element.error ?? element.displayName">
                                    <i t-if="element.error" class="o_button_icon fa fa-fw fa-exclamation-circle text-danger me-1"/>
                                    <span t-out="element.displayName"/>
                                </div>
                                <div class="ms-auto" t-att-data-tooltip-template="'web.OfflineSystrayTooltip'" t-att-data-tooltip-info="element.tooltip">
                                    <span t-attf-class="o_tag mw-100 o_badge badge rounded-pill {{ 'o_tag_color_' + element.status.color }}">
                                        <t class="o_tag_badge_text o_badge_text" t-out="element.status.label"/>
                                    </span>
                                </div>
                                <div>
                                    <button class="btn btn-link text-danger fa fa-trash py-0" title="Discard offline changes" data-available-offline="" t-on-click.stop="() =&gt; this.discard(element.id)"/>
                                </div>
                            </DropdownItem>
                        </t>
                    </t>
                </div>
            </t>
        </Dropdown>
    </t>

    `);
registerTemplate("web.OfflineSystrayTooltip", `/web/static/src/webclient/offline_systray/offline_systray.xml`, `<t t-name="web.OfflineSystrayTooltip" xml:space="preserve">
